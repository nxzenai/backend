# Marketing database
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_URL=mongodb+srv://nxzenai_admin:nxzenai@cluster0.p6h7hjw.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MARKETING_DB=nxzenai_marketing

# Application
APP_NAME=NxZenAI Studio
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8001
API_PREFIX=/api/v1

# Security (replace in every deployed environment)
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Studio database (the cluster may match MONGODB_URL; keep a separate DB)
MONGODB_URL=mongodb+srv://nxzenai_admin:nxzenai@cluster0.p6h7hjw.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
DATABASE_NAME=ai_studio

# Object storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=ai-studio
MINIO_SECURE=false

# Execution
DOCKER_NETWORK=bridge
PYTHON_RUNNER_IMAGE=python:3.12
NOTEBOOK_RUNNER_IMAGE=python:3.12

# Frontend and logging
#FRONTEND_URL=http://localhost:3001
FRONTEND_URL=https://www.nxzenai.com
LOG_LEVEL=INFO

# Demo booking email (server-side only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=bhargav@nxzenai.com
SMTP_PASSWORD=zdht xxof vtuo siag
SMTP_FROM_EMAIL=bhargav@nxzenai.com
SMTP_FROM_NAME=NxZenAI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_ADMIN_RECIPIENTS=bhargav@nxzenai.com,fayaz@nxzenai.com,roushan@nxzenai.com,shruthi.n@nxzenai.com
# AutoDL / AutoNLP local training safety
AI_TRAINING_MAX_UPLOAD_BYTES=52428800
AI_TRAINING_MAX_EPOCHS=50
AI_TRAINING_MAX_WORKERS=1
AI_TRAINING_MAX_PENDING_JOBS=4
AI_TRAINING_MAX_ROWS=100000
AI_TRAINING_MAX_ARCHIVE_ENTRIES=5000
AI_TRAINING_MAX_ARCHIVE_BYTES=104857600
AI_TRAINING_DEVICE_POLICY=auto
AUTODL_EXECUTION_MODE=direct
# One in-process AutoDL trainer is the safe local/direct default.
AUTODL_DIRECT_CONCURRENCY=1
# Production AutoDL in-process resource controls (internal V2 setting names retained).
AUTODL_V2_TRAINING_SLOTS=1
AUTODL_V2_DATALOADER_WORKERS=0

# Durable AutoDL / AutoNLP queue and worker
AI_JOB_QUEUE_DATABASE_URL=sqlite:///./ai_jobs.db
# Legacy rollback only; ignored when AUTODL_EXECUTION_MODE=direct.
AUTODL_DATABASE_URL=sqlite:///./autodl.db
AUTONLP_DATABASE_URL=sqlite:///./autonlp.db
AI_REGISTRY_DATABASE_URL=sqlite:///./ai_registry.db

AI_JOB_SPOOL_ROOT=data/ai-job-queue

# Keep localhost conservative to avoid freezing the machine
AI_JOB_CPU_CONCURRENCY=1
AI_JOB_GPU_CONCURRENCY=1
AI_JOB_QUEUE_CAPACITY=10

AI_JOB_TIMEOUT_SECONDS=3600
AI_JOB_MAX_RETRIES=1
AI_JOB_RETRY_DELAY_SECONDS=30
AI_JOB_LEASE_SECONDS=120
AI_JOB_POLL_SECONDS=2
AI_JOB_SHUTDOWN_GRACE_SECONDS=30

# Local Windows safety
# If this setting is enforced only on Linux in your implementation,
# it will simply have no effect on Windows.
AI_JOB_MAX_MEMORY_MB=4096

# Existing local artifacts remain default
AI_ARTIFACT_STORAGE_BACKEND=local
AI_ARTIFACT_LOCAL_ROOT=artifacts
AI_STORAGE_CACHE_ROOT=data/ai-storage-cache

# DigitalOcean Spaces - keep disabled locally
# AI_SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# AI_SPACES_REGION=nyc3
# AI_SPACES_BUCKET=replace-me
# AI_SPACES_ACCESS_KEY=replace-me
# AI_SPACES_SECRET_KEY=replace-me
AI_SPACES_PREFIX=nxzen-ai

# Retention
AI_RETENTION_ENABLED=false
AI_STAGED_INPUT_RETENTION_HOURS=24
AI_FAILED_JOB_RETENTION_DAYS=30
AI_ARCHIVED_ARTIFACT_RETENTION_DAYS=90
AI_PREDICTION_METADATA_RETENTION_DAYS=90
AI_RETENTION_INTERVAL_SECONDS=3600

AUTODL_V2_TIMESTAMP_AUTO_CLEAN_PERCENT=2
AUTODL_V2_TIMESTAMP_BLOCK_PERCENT=20
AUTODL_V2_IMAGE_AUGMENTATION_ENABLED=true
AUTODL_V2_IMAGE_LOW_CONFIDENCE_THRESHOLD=0.70
# Explicit opt-in only for pre-v2-integrity artifacts after legacy contract checks.
AUTODL_V2_ALLOW_LEGACY_INTEGRITY=false
