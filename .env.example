MONGODB_URI=mongodb+srv://bhargav_db_nxzenai:nxzenai11@cluster0.yqmy39.mongodb.net/?appName=Cluster0
STUDIO_DB=ai_studio_db
LEADS_DB=nxzenai_leads
AUDIT_DB=nxzenai_audit

# Application
APP_NAME=NxZenAI Studio
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8001
API_PREFIX=/api/v1

# Security (replace in every deployed environment)
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# Object storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=ai-studio
MINIO_SECURE=false

# Execution
DOCKER_NETWORK=bridge
PYTHON_RUNNER_IMAGE=python:3.12
NOTEBOOK_RUNNER_IMAGE=python:3.12

# Frontend and logging
FRONTEND_URL=http://localhost:3001
#FRONTEND_URL=https://www.nxzenai.com
LOG_LEVEL=INFO

# Demo booking email (server-side only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=bhargav@nxzenai.com
SMTP_PASSWORD=zdht xxof vtuo siag
SMTP_FROM_EMAIL=bhargav@nxzenai.com
SMTP_FROM_NAME=NxZenAI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_ADMIN_RECIPIENTS=bhargav@nxzenai.com,fayaz@nxzenai.com,roushan@nxzenai.com,shruthi.n@nxzenai.com
# AutoDL / AutoNLP local training safety
AI_TRAINING_MAX_UPLOAD_BYTES=52428800
AI_TRAINING_MAX_EPOCHS=50
AI_TRAINING_MAX_WORKERS=1
AI_TRAINING_MAX_PENDING_JOBS=4
AI_TRAINING_MAX_ROWS=100000
AI_TRAINING_MAX_ARCHIVE_ENTRIES=5000
AI_TRAINING_MAX_ARCHIVE_BYTES=104857600
AI_TRAINING_DEVICE_POLICY=auto
# Optional AutoNLP recurrent initialization. Point to the extracted GloVe 6B 100d text file.
# If unset, recurrent models use the explicitly reported trainable random fallback.
AUTONLP_GLOVE_PATH=
# Optional: unfreeze pretrained GloVe embeddings after this completed epoch (for example, 1).
AUTONLP_GLOVE_UNFREEZE_AFTER_EPOCH=
AUTODL_EXECUTION_MODE=direct
# One in-process AutoDL trainer is the safe local/direct default.
AUTODL_DIRECT_CONCURRENCY=1
# Production AutoDL in-process resource controls (internal V2 setting names retained).
AUTODL_V2_TRAINING_SLOTS=1
AUTODL_V2_DATALOADER_WORKERS=0

# Durable AutoDL / AutoNLP queue and worker
AI_JOB_QUEUE_DATABASE_URL=sqlite:///./ai_jobs.db
# Legacy rollback only; ignored when AUTODL_EXECUTION_MODE=direct.
AUTODL_DATABASE_URL=sqlite:///./autodl.db

AI_JOB_SPOOL_ROOT=data/ai-job-queue

# Keep localhost conservative to avoid freezing the machine
AI_JOB_CPU_CONCURRENCY=1
AI_JOB_GPU_CONCURRENCY=1
AI_JOB_QUEUE_CAPACITY=10

AI_JOB_TIMEOUT_SECONDS=3600
AI_JOB_MAX_RETRIES=1
AI_JOB_RETRY_DELAY_SECONDS=30
AI_JOB_LEASE_SECONDS=120
AI_JOB_POLL_SECONDS=2
AI_JOB_SHUTDOWN_GRACE_SECONDS=30

# Local Windows safety
# If this setting is enforced only on Linux in your implementation,
# it will simply have no effect on Windows.
AI_JOB_MAX_MEMORY_MB=4096

# Existing local artifacts remain default
AI_ARTIFACT_STORAGE_BACKEND=local
AI_ARTIFACT_LOCAL_ROOT=artifacts
AI_STORAGE_CACHE_ROOT=data/ai-storage-cache

# DigitalOcean Spaces - keep disabled locally
# AI_SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# AI_SPACES_REGION=nyc3
# AI_SPACES_BUCKET=replace-me
# AI_SPACES_ACCESS_KEY=replace-me
# AI_SPACES_SECRET_KEY=replace-me
AI_SPACES_PREFIX=nxzen-ai

# Retention
AI_RETENTION_ENABLED=false
AI_STAGED_INPUT_RETENTION_HOURS=24
AI_FAILED_JOB_RETENTION_DAYS=30
AI_ARCHIVED_ARTIFACT_RETENTION_DAYS=90
AI_PREDICTION_METADATA_RETENTION_DAYS=90
AI_RETENTION_INTERVAL_SECONDS=3600

AUTODL_V2_TIMESTAMP_AUTO_CLEAN_PERCENT=2
AUTODL_V2_TIMESTAMP_BLOCK_PERCENT=20
AUTODL_V2_IMAGE_AUGMENTATION_ENABLED=true
AUTODL_V2_IMAGE_LOW_CONFIDENCE_THRESHOLD=0.70
# Explicit opt-in only for pre-v2-integrity artifacts after legacy contract checks.
AUTODL_V2_ALLOW_LEGACY_INTEGRITY=false
# GenAI: FAST/BALANCED/DEEP are logical tiers, not model families.
# Each tier independently configures BASE_URL, API_KEY, MODEL,
# CONTEXT_TOKENS and MAX_OUTPUT_TOKENS. No code changes are needed to
# point a tier at a hosted OpenAI-compatible Chat Completions endpoint.
# BASE_URL must include the API prefix (for example https://provider.example/v1),
# but not /chat/completions. MODEL must match that endpoint's model identifier.
# Keep real keys in the deployment environment, never in this example file.
# Set each MODEL to the exact OpenRouter catalog ID you want for that tier.
# Set each API_KEY in the deployment environment. Empty model or key disables
# an OpenRouter tier. Native labs do not require a configured tier.
# Transport failures do not trigger retries or silent provider fallback.
GENAI_FAST_BASE_URL=https://openrouter.ai/api/v1
GENAI_FAST_API_KEY=
GENAI_FAST_MODEL=inclusionai/ling-3.0-flash-fin:free
GENAI_FAST_CONTEXT_TOKENS=4096
GENAI_FAST_MAX_OUTPUT_TOKENS=512
GENAI_BALANCED_BASE_URL=https://openrouter.ai/api/v1
GENAI_BALANCED_API_KEY=
GENAI_BALANCED_MODEL=cohere/north-mini-code:free
GENAI_BALANCED_CONTEXT_TOKENS=16384
GENAI_BALANCED_MAX_OUTPUT_TOKENS=1200
GENAI_DEEP_BASE_URL=https://openrouter.ai/api/v1
GENAI_DEEP_API_KEY=
GENAI_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b-20260604:free
GENAI_DEEP_CONTEXT_TOKENS=32768
GENAI_DEEP_MAX_OUTPUT_TOKENS=2000
GENAI_INFERENCE_TIMEOUT_SECONDS=120
GENAI_TOOL_TIMEOUT_SECONDS=20
GENAI_WEB_SEARCH_PROVIDER=tavily
GENAI_WEB_SEARCH_URL=https://api.tavily.com/search
GENAI_WEB_SEARCH_API_KEY=
GENAI_WEB_MAX_RESULTS=5
GENAI_WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
GENAI_WEATHER_API_KEY=
GENAI_WEATHER_GEOCODING_URL=https://api.openweathermap.org/geo/1.0/direct
GENAI_WEATHER_UNITS=metric
GENAI_MAX_ATTACHMENT_BYTES=10485760
