# =========================================================
# NxZenAI Backend - Environment Example
# =========================================================


# ---------------------------------------------------------
# Marketing / AI Studio Database
# ---------------------------------------------------------

MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>/?retryWrites=true&w=majority

DATABASE_NAME=ai_studio
MARKETING_DB=nxzenai_marketing


# ---------------------------------------------------------
# Application
# ---------------------------------------------------------

APP_NAME=NxZenAI Studio
APP_VERSION=1.0.0

ENVIRONMENT=development
DEBUG=false

HOST=0.0.0.0
PORT=8001

API_PREFIX=/api/v1


# ---------------------------------------------------------
# Security
# ---------------------------------------------------------

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60


# ---------------------------------------------------------
# Object Storage
# ---------------------------------------------------------

MINIO_ENDPOINT=127.0.0.1:9000

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-me

MINIO_BUCKET=ai-studio
MINIO_SECURE=false


# ---------------------------------------------------------
# Execution
# ---------------------------------------------------------

DOCKER_NETWORK=bridge

PYTHON_RUNNER_IMAGE=python:3.12
NOTEBOOK_RUNNER_IMAGE=python:3.12


# ---------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------

# Local development
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001


# For deployed production, override with:
# ENVIRONMENT=production
# FRONTEND_URL=https://www.nxzenai.com
# CORS_ORIGINS=https://www.nxzenai.com


# ---------------------------------------------------------
# Logging
# ---------------------------------------------------------

LOG_LEVEL=INFO